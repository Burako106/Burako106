{
  // Burako 106 en Cloudflare: la página del juego (carpeta public) + el servidor de mesas (src/worker.js)
  "name": "burako106",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "PLAYERS", "class_name": "Players" },
      { "name": "BACKUPS", "class_name": "Backups" },
      { "name": "VOZ", "class_name": "Voz" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v3", "new_sqlite_classes": ["Players"] },
    { "tag": "v4", "new_sqlite_classes": ["Backups"] },
    { "tag": "v5", "new_sqlite_classes": ["Voz"] }
  ],
  "routes": [
    { "pattern": "burako106.com", "custom_domain": true },
    { "pattern": "www.burako106.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["17 7 * * *"] },
  "workers_dev": true
}
