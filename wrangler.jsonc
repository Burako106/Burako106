{
  // Burako 106 en Cloudflare: la página del juego (carpeta public) + el servidor de mesas (src/worker.js)
  "name": "burako106",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [
    { "pattern": "burako106.com", "custom_domain": true },
    { "pattern": "www.burako106.com", "custom_domain": true }
  ],
  "workers_dev": true
}
